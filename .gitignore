# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
real_life_reference/

# local assistant tooling (skills, agents); the film and jev skills and the project hooks are versioned
.claude/*
!.claude/skills/
!.claude/settings.json
.claude/skills/*
!.claude/skills/econ-film/
!.claude/skills/jev/
.agents/
skills-lock.json

# tauri (Cargo.lock is committed on purpose: reproducible desktop builds)
/src-tauri/target
/src-tauri/gen

# website demo media (npm run demo)
/demo-media/

# product film (scripts/film has its own deps; the score's Python venv)
/scripts/film/node_modules/
/scripts/film/score/.venv/
__pycache__/
