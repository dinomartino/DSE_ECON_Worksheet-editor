{
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/jev/bin/find.mjs *)",
      "Bash(node .claude/skills/jev/bin/verify-plan.mjs*)",
      "Bash(node .claude/skills/jev/bin/doctor.mjs)",
      "Bash(node .claude/skills/jev/bin/lint-delta.mjs)",
      "Bash(node */.claude/skills/jev/bin/lint-delta.mjs* --stdin)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/jev/bin/pointers-hook.mjs\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/jev/bin/guard-hook.mjs\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm run lint*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/jev/bin/lint-filter-hook.mjs\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
