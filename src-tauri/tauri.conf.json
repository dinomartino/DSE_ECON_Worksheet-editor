{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Econ Worksheet",
  "version": "0.2.0",
  "identifier": "hk.econworksheet.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Econ Worksheet",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Tino Ho",
    "category": "Education",
    "shortDescription": "Bilingual HKDSE Economics worksheet editor",
    "longDescription": "Build bilingual (English / 繁體中文) HKDSE Economics worksheets and export native Microsoft Word documents.",
    "copyright": "© Tino Ho",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "TradChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQTZDMzI4NkVDOTFGNjkKUldScEg4bHVLTU9ta0NINzVSM0hYb244b1psVnFrNWpGQkxMZHozYXNuYUlEaTcvczdaaU02UlcK",
      "endpoints": [
        "https://github.com/dinomartino/DSE_ECON_Worksheet-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
