    {
      "id": "m-045",
      "type": "mcq",
      "blocks": [
        {
          "kind": "paragraph",
          "id": "m-046",
          "text": {
            "en": [
              {
                "text": "Which of the following is correct about the two policies in the table?"
              }
            ],
            "zh": [
              {
                "text": "就表中的兩項政策，以下哪項正確？"
              }
            ]
          }
        },
        {
          "kind": "table",
          "id": "m-047",
          "rows": [
            {
              "id": "m-048",
              "cells": [
                {
                  "id": "m-049",
                  "text": {
                    "en": [
                      {
                        "text": "A subsidy lowers the cost of production, so the supply curve of the good shifts to the right and its equilibrium price falls."
                      }
                    ],
                    "zh": [
                      {
                        "text": "補貼降低生產成本，因此該貨品的供應曲線右移，均衡價格下降。"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "m-050",
              "cells": [
                {
                  "id": "m-051",
                  "text": {
                    "en": [
                      {
                        "text": "The tax raises the cost of production, so the supply curve shifts to the left and the equilibrium price rises."
                      }
                    ],
                    "zh": [
                      {
                        "text": "稅項提高生產成本，因此供應曲線左移，均衡價格上升。"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ],
      "marks": 1,
      "options": [
        {
          "id": "m-052",
          "text": {
            "en": [
              {
                "text": "Both policies raise the equilibrium price"
              }
            ],
            "zh": [
              {
                "text": "兩項政策均令均衡價格上升"
              }
            ]
          }
        },
        {
          "id": "m-053",
          "text": {
            "en": [
              {
                "text": "Only the subsidy lowers the equilibrium price"
              }
            ],
            "zh": [
              {
                "text": "只有補貼令均衡價格下降"
              }
            ]
          }
        },
        {
          "id": "m-054",
          "text": {
            "en": [
              {
                "text": "Only the tax lowers the equilibrium price"
              }
            ],
            "zh": [
              {
                "text": "只有稅項令均衡價格下降"
              }
            ]
          }
        },
