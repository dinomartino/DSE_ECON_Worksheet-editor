{
  "name": "econgen",
  "version": "0.1.0",
  "description": "Bilingual HKDSE Economics worksheet editor that exports native Microsoft Word .docx",
  "license": "MIT",
  "author": "Tino Ho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinomartino/DSE_ECON_Worksheet-editor.git"
  },
  "homepage": "https://github.com/dinomartino/DSE_ECON_Worksheet-editor#readme",
  "bugs": {
    "url": "https://github.com/dinomartino/DSE_ECON_Worksheet-editor/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "typecheck": "tsc --noEmit",
    "samples": "vitest run scripts/emit-samples.test.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "npm run sync-version && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "jszip": "^3.10.1",
    "nanoid": "^6.0.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fast-xml-parser": "^5.10.1",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
