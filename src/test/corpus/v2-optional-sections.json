      "parts": [],
      "marks": 12,
      "answer": {
        "en": [
          {
            "text": "Raises wages of those employed; may cut employment."
          }
        ],
        "zh": [
          {
            "text": "提高受僱者工資；或減少就業。"
          }
        ]
      },
