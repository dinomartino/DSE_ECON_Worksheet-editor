  "questions": [
    {
      "id": "os005",
      "type": "structured",
      "blocks": [
        {
          "kind": "paragraph",
          "id": "os006",
          "text": {
            "en": [
              {
                "text": "A city plans to turn a harbour-front car park into a public garden."
              }
            ],
            "zh": [
              {
                "text": "某城市計劃將海旁停車場改建為公園。"
              }
            ]
          }
        }
      ],
      "parts": [
        {
          "id": "os007",
          "blocks": [
            {
              "kind": "paragraph",
              "id": "os008",
              "text": {
                "en": [
                  {
                    "text": "State the opportunity cost of the plan."
                  }
                ],
                "zh": [
                  {
                    "text": "寫出該計劃的機會成本。"
                  }
                ]
              }
            }
          ],
          "marks": 2,
          "answerSpace": 5
        },
        {
          "id": "os009",
          "blocks": [
            {
              "kind": "paragraph",
              "id": "os010",
              "text": {
                "en": [
                  {
                    "text": "Explain ONE reason why the garden may be under-provided by the market."
                  }
                ],
                "zh": [
                  {
                    "text": "解釋市場可能對公園供應不足的"
                  },
                  {
                    "text": "一個",
                    "bold": true
                  },
                  {
                    "text": "原因。"
                  }
                ]
              }
            }
          ],
          "marks": 4,
          "answerSpace": 8
        }
      ]
    },
    {
      "id": "os011",
      "type": "structured",
      "blocks": [
        {
          "kind": "paragraph",
          "id": "os012",
          "text": {
            "en": [
              {
                "text": "Study the market for taxis."
              }
            ],
            "zh": [
              {
                "text": "細閱的士市場。"
              }
            ]
          }
        }
      ],
      "parts": [
        {
          "id": "os013",
          "blocks": [
            {
              "kind": "paragraph",
              "id": "os014",
              "text": {
                "en": [
                  {
                    "text": "Explain one barrier to entry."
                  }
                ],
                "zh": [
                  {
                    "text": "解釋一項入行限制。"
                  }
                ]
              }
            }
          ],
          "marks": 3,
          "answer": {
            "en": [
              {
                "text": "Licence quota."
              }
            ],
            "zh": [
              {
                "text": "牌照配額。"
              }
            ]
          },
          "tags": [
            "E.monopoly"
          ],
          "rootId": "Mu6c11aXeA"
        },
        {
          "id": "os015",
          "blocks": [
            {
              "kind": "paragraph",
              "id": "os016",
              "text": {
                "en": [
                  {
                    "text": "Is the market contestable?"
                  }
                ],
                "zh": [
                  {
                    "text": "市場是否可競爭？"
                  }
                ]
              }
            }
          ],
          "marks": 5,
