      "id": "mc005",
      "type": "mcq",
      "blocks": [
        {
          "kind": "paragraph",
          "id": "mc006",
          "text": {
            "en": [
              {
                "text": "Which of the following statements about a price ceiling are correct?"
              }
            ],
            "zh": [
              {
                "text": "以下有關價格上限的陳述，哪些正確？"
              }
            ]
          }
        }
      ],
      "marks": 1,
      "options": [
        {
          "id": "mc007",
          "text": {
            "en": [
              {
                "text": "(1) only"
              }
            ],
            "zh": [
              {
                "text": "只有(1)"
              }
            ]
          }
        },
        {
          "id": "mc008",
          "text": {
            "en": [
              {
                "text": "(1) and (2) only"
              }
            ],
            "zh": [
              {
                "text": "只有(1)和(2)"
              }
            ]
          }
        },
        {
          "id": "mc009",
          "text": {
            "en": [
              {
                "text": "(2) and (3) only"
              }
            ],
            "zh": [
              {
                "text": "只有(2)和(3)"
              }
            ]
          }
        },
        {
          "id": "mc010",
          "text": {
            "en": [
              {
                "text": "(1), (2) and (3)"
              }
            ],
            "zh": [
              {
                "text": "(1)、(2)和(3)"
              }
            ]
          }
        }
      ],
      "answerIndex": 1,
      "statements": [
        {
          "en": [
            {
              "text": "It may cause a shortage."
            }
          ],
          "zh": [
            {
              "text": "可能引致短缺。"
            }
          ]
        },
        {
          "en": [
            {
              "text": "It must be set below the equilibrium price to bind."
            }
          ],
          "zh": [
            {
              "text": "必須定於均衡價格以下才有效。"
            }
          ]
        },
        {
          "en": [
            {
              "text": "It raises the equilibrium price."
            }
          ],
          "zh": [
            {
              "text": "提高均衡價格。"
            }
          ]
        }
      ],
      "explanation": {
        "en": [
          {
            "text": "(3) is wrong: a binding ceiling holds price below equilibrium."
          }
        ],
        "zh": [
          {
            "text": "(3)錯誤：有效的價格上限令價格低於均衡價格。"
          }
        ]
      },
